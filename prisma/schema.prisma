// ============================================
// Prisma Schema Base Configuration
// ============================================
// This file contains generator and datasource settings
// Model files are in the models/ directory

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:12345@localhost:5432/pos-backend?schema=public"
}


// ============================================
// Models (merged from models/ directory)
// Auto-generated - DO NOT EDIT MANUALLY
// ============================================

// --- enums.prisma ---
// ============================================
// Enums
// ============================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

// --- user.model.prisma ---
// ============================================
// User Management Models
// ============================================

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  username          String?     @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  role              UserRole    @default(USER)
  status            UserStatus  @default(PENDING_VERIFICATION)
  emailVerified     Boolean     @default(false)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  passwordResetToken String?
  passwordResetAt   DateTime?
  profileImage      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  createdBy         String?
  updatedBy         String?

  // Relations
  createdUsers      User[]      @relation("UserCreatedBy")
  updatedUsers      User[]      @relation("UserUpdatedBy")
  createdByUser     User?       @relation("UserCreatedBy", fields: [createdBy], references: [id])
  updatedByUser     User?       @relation("UserUpdatedBy", fields: [updatedBy], references: [id])

  @@map("users")
  @@index([email])
  @@index([username])
  @@index([role])
  @@index([status])
}

