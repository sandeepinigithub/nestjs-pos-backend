// --- inventory.model.prisma ---
// ============================================
// Inventory Management Models
// ============================================

// Inventory (Stock at store level)
model Inventory {
  id          String   @id @default(cuid())
  productId   String
  storeId     String
  
  // Stock Levels
  quantity    Int      @default(0)
  reservedQuantity Int @default(0) // Reserved for pending orders
  availableQuantity Int @default(0) // quantity - reservedQuantity
  
  // Reordering
  reorderLevel Int?    // Minimum stock level
  maxLevel     Int?    // Maximum stock level
  
  // Location within store
  location    String?  // e.g., "Aisle 1", "Freezer 2"
  
  // Last update
  lastUpdated DateTime @default(now())
  updatedBy   String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  product     Product  @relation(fields: [productId], references: [id])
  store       Store    @relation(fields: [storeId], references: [id])
  movements   InventoryMovement[]
  updatedByUser User?  @relation("InventoryUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([productId, storeId])
  @@map("inventory")
  @@index([productId])
  @@index([storeId])
  @@index([availableQuantity])
}

// Inventory Movement (Stock transactions)
model InventoryMovement {
  id          String   @id @default(cuid())
  inventoryId String
  movementType InventoryMovementType
  
  // Movement Details
  quantity    Int      // Positive for IN, negative for OUT
  reference   String?  // Reference to order, transfer, etc.
  referenceId String?  // ID of related entity (orderId, transferId, etc.)
  
  // Reason
  reason      String?
  notes       String?
  
  // Cost (for accounting)
  unitCost    Decimal? @db.Decimal(10, 2)
  totalCost   Decimal? @db.Decimal(10, 2)
  
  createdAt   DateTime @default(now())
  createdBy   String?

  // Relations
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  createdByUser User?   @relation("InventoryMovementCreatedBy", fields: [createdBy], references: [id])

  @@map("inventory_movements")
  @@index([inventoryId])
  @@index([movementType])
  @@index([referenceId])
  @@index([createdAt])
}

// Inventory Adjustment (document header)
model InventoryAdjustment {
  id                String            @id @default(cuid())
  adjustmentNumber  String            @unique
  storeId          String
  adjustmentDate    DateTime
  reason            String
  reference         String?
  status            AdjustmentStatus   @default(DRAFT)
  totalValue        Decimal?          @db.Decimal(10, 2)
  notes             String?
  createdBy         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  store             Store             @relation(fields: [storeId], references: [id])
  lines             InventoryAdjustmentLine[]
  createdByUser     User?              @relation("InventoryAdjustmentCreatedBy", fields: [createdBy], references: [id])

  @@map("inventory_adjustments")
  @@index([adjustmentNumber])
  @@index([storeId])
  @@index([status])
  @@index([adjustmentDate])
}

// Inventory Adjustment Line
model InventoryAdjustmentLine {
  id                String              @id @default(cuid())
  adjustmentId      String
  productId         String
  quantityDelta     Int                 // positive = IN, negative = OUT
  unitCost          Decimal?            @db.Decimal(10, 2)
  notes             String?

  // Relations
  adjustment        InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id])

  @@map("inventory_adjustment_lines")
  @@index([adjustmentId])
  @@index([productId])
}

// --- loyalty.model.prisma ---
// ============================================
// Loyalty & Rewards Models
// ============================================

// Customer
model Customer {
  id          String   @id @default(cuid())
  customerNumber String @unique // e.g., "CUST-2025-001234"
  
  // Personal Info
  firstName   String
  lastName    String
  email       String?  @unique
  phone       String?  @unique
  
  // Address
  address     String?
  city        String?
  state       String?
  postalCode  String?
  country     String?
  
  // Loyalty
  loyaltyPoints Int    @default(0)
  tier         String? // e.g., "GOLD", "PLATINUM"
  joinedAt     DateTime @default(now())
  
  // Preferences
  preferences Json?    // e.g., favorite products, dietary restrictions
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  orders      Order[]
  loyaltyTransactions LoyaltyTransaction[]
  bogoVouchers BOGOVoucher[]

  @@map("customers")
  @@index([customerNumber])
  @@index([email])
  @@index([phone])
  @@index([isActive])
}

// Loyalty Program Configuration
model LoyaltyProgram {
  id          String   @id @default(cuid())
  name        String
  description String?
  
  // Points Configuration
  pointsPerDollar Decimal @db.Decimal(5, 2) // e.g., 1.5 points per dollar
  pointsPerOrder  Int?    // Fixed points per order
  
  // Redemption Rules
  redemptionRules Json?   // e.g., 100 points = $1 discount
  
  // Tiers
  tiers       Json?    // Tier definitions and benefits
  
  // Validity
  isActive    Boolean  @default(true)
  startDate   DateTime @default(now())
  endDate     DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("loyalty_programs")
  @@index([isActive])
}

// Loyalty Transaction
model LoyaltyTransaction {
  id          String   @id @default(cuid())
  customerId  String
  orderId     String?  // Related order (if applicable)
  
  // Transaction Details
  transactionType LoyaltyTransactionType
  points      Int     // Positive for earn, negative for redeem
  balance     Int     // Balance after transaction
  
  // Reference
  reference   String? // e.g., "Order #12345", "Promotion", "Adjustment"
  notes       String?
  
  // Expiry (for earned points)
  expiresAt   DateTime?
  
  createdAt   DateTime @default(now())
  createdBy   String?

  // Relations
  customer    Customer @relation(fields: [customerId], references: [id])
  order       Order?   @relation(fields: [orderId], references: [id])
  createdByUser User?  @relation("LoyaltyTransactionCreatedBy", fields: [createdBy], references: [id])

  @@map("loyalty_transactions")
  @@index([customerId])
  @@index([orderId])
  @@index([transactionType])
  @@index([createdAt])
}

// --- order.model.prisma ---
// ============================================
// Order & Sales Models
// ============================================

// Order
model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique // e.g., "ORD-2025-001234"
  storeId         String
  customerId      String?     // For registered customers
  customerName    String?     // For guest orders
  customerPhone   String?
  customerEmail   String?
  
  // Order Details
  status          OrderStatus @default(PENDING)
  orderType       String?     // e.g., "DINE_IN", "TAKEAWAY", "DELIVERY"
  
  // Pricing
  subtotal        Decimal     @db.Decimal(10, 2)
  taxAmount       Decimal     @db.Decimal(10, 2)
  discountAmount  Decimal    @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal     @db.Decimal(10, 2)
  loyaltyPointsUsed Int?      @default(0)
  loyaltyPointsEarned Int?    @default(0)
  
  // Payment
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod?
  
  // Order Hold/Resume
  isHeld          Boolean     @default(false)
  heldAt          DateTime?
  heldBy          String?
  heldReason      String?
  resumedAt       DateTime?
  resumedBy       String?
  
  // Metadata
  notes           String?
  orderDate       DateTime    @default(now())
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelledBy    String?
  cancelledReason String?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdBy       String?
  updatedBy       String?

  // Relations
  store           Store       @relation(fields: [storeId], references: [id])
  customer        Customer?   @relation(fields: [customerId], references: [id])
  orderItems      OrderItem[]
  payments        Payment[]
  loyaltyTransactions LoyaltyTransaction[]
  createdByUser   User?       @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User?       @relation("OrderUpdatedBy", fields: [updatedBy], references: [id])
  cancelledByUser User?      @relation("OrderCancelledBy", fields: [cancelledBy], references: [id])
  heldByUser      User?       @relation("OrderHeldBy", fields: [heldBy], references: [id])
  resumedByUser   User?       @relation("OrderResumedBy", fields: [resumedBy], references: [id])
  kots            KOT[]
  tastings        Tasting[]
  bogoApplications BOGOApplication[]
  vouchersGenerated BOGOVoucher[] @relation("VoucherGeneratedFrom")
  vouchersRedeemed BOGOVoucher[] @relation("VoucherRedeemedIn")

  @@map("orders")
  @@index([orderNumber])
  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@index([paymentStatus])
  @@index([isHeld])
}

// KOT (Kitchen Order Ticket)
model KOT {
  id                String   @id @default(cuid())
  kotNumber         String   @unique // e.g., "KOT-2025-001234"
  orderId           String
  storeId           String
  
  // KOT Details
  status            String   @default("PENDING") // PENDING, SENT, PREPARING, READY, COMPLETED
  items             Json     // Array of order items for kitchen
  tableNumber       String?
  notes             String?
  
  // Timing
  sentAt            DateTime @default(now())
  completedAt       DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?

  // Relations
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store             Store    @relation(fields: [storeId], references: [id])
  createdByUser     User?    @relation("KOTCreatedBy", fields: [createdBy], references: [id])

  @@map("kots")
  @@index([kotNumber])
  @@index([orderId])
  @@index([storeId])
  @@index([status])
  @@index([sentAt])
}

// Tasting Tracking
model Tasting {
  id                String   @id @default(cuid())
  orderId           String
  productId         String
  
  // Tasting Details
  quantity          Int      @default(1)
  tastingType       String   @default("SAMPLE") // SAMPLE, COMPLIMENTARY, PROMOTIONAL
  customerFeedback  String?  // Customer feedback on tasting
  notes             String?
  
  createdAt         DateTime @default(now())
  createdBy         String?

  // Relations
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id])
  createdByUser     User?    @relation("TastingCreatedBy", fields: [createdBy], references: [id])

  @@map("tastings")
  @@index([orderId])
  @@index([productId])
  @@index([createdAt])
}

// Order Item
model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  taxId       String?
  
  // Item Details
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  taxRate     Decimal? @db.Decimal(5, 2)
  taxAmount   Decimal  @default(0) @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  
  // Customizations
  notes       String?
  attributes  Json?    // e.g., size, add-ons, etc.
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  tax         Tax?     @relation(fields: [taxId], references: [id])

  @@map("order_items")
  @@index([orderId])
  @@index([productId])
}

// Payment
model Payment {
  id              String         @id @default(cuid())
  orderId         String
  paymentMethod   PaymentMethod
  amount          Decimal        @db.Decimal(10, 2)
  status          PaymentStatus  @default(PENDING)
  
  // Transaction Details
  transactionId   String?        @unique // External transaction ID
  referenceNumber String?        // Payment reference
  receiptUrl      String?        // Receipt/image URL
  
  // Metadata
  processedAt      DateTime?
  refundedAt      DateTime?
  refundAmount    Decimal?       @db.Decimal(10, 2)
  refundReason    String?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
  @@index([orderId])
  @@index([transactionId])
  @@index([status])
  @@index([paymentMethod])
}

// --- permission.model.prisma ---
// ============================================
// Permission System Models
// ============================================

// Group with hierarchical support
model Group {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique // e.g., "MANAGERS", "CASHIERS"
  description String?
  parentId    String?
  level       Int      @default(0) // Hierarchy level
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  // Self-referential hierarchy
  parent      Group?   @relation("GroupHierarchy", fields: [parentId], references: [id])
  children    Group[]  @relation("GroupHierarchy")

  // Relations
  groupPermissions GroupPermission[]
  userGroups      UserGroup[]
  createdByUser   User?      @relation("GroupCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User?      @relation("GroupUpdatedBy", fields: [updatedBy], references: [id])

  @@map("groups")
  @@index([parentId])
  @@index([code])
  @@index([isActive])
}

// Base Permission definitions
model Permission {
  id          String   @id @default(cuid())
  resource    PermissionResource
  action      PermissionAction
  name        String  // e.g., "Create User", "View Sales Report"
  description String?
  module      PermissionModule? // Module category
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  groupPermissions GroupPermission[]
  userPermissions UserPermission[]
  accessPermissions AccessPermission[]
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
  @@index([resource])
  @@index([module])
  @@index([isActive])
}

// Access Permission - Store/Region specific permissions
model AccessPermission {
  id          String   @id @default(cuid())
  permissionId String
  storeId     String?  // null = global permission
  regionId    String?  // null = global permission
  isAllowed   Boolean  @default(true)
  conditions  Json?    // Additional conditions (e.g., time restrictions, amount limits)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  // Relations
  permission  Permission @relation(fields: [permissionId], references: [id])
  store       Store?     @relation(fields: [storeId], references: [id])
  region      Region?    @relation(fields: [regionId], references: [id])
  createdByUser User?    @relation("AccessPermissionCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?    @relation("AccessPermissionUpdatedBy", fields: [updatedBy], references: [id])

  @@map("access_permissions")
  @@index([permissionId])
  @@index([storeId])
  @@index([regionId])
  @@index([isAllowed])
}

// Group-Permission mapping
model GroupPermission {
  id            String   @id @default(cuid())
  groupId       String
  permissionId  String
  isAllowed     Boolean  @default(true)
  conditions    Json?    // Additional conditions
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  grantedBy     String?

  // Relations
  group         Group      @relation(fields: [groupId], references: [id])
  permission    Permission @relation(fields: [permissionId], references: [id])
  grantedByUser User?      @relation("GroupPermissionGrantedBy", fields: [grantedBy], references: [id])

  @@unique([groupId, permissionId])
  @@map("group_permissions")
  @@index([groupId])
  @@index([permissionId])
}

// User-Permission mapping (direct permissions override group permissions)
model UserPermission {
  id            String   @id @default(cuid())
  userId        String
  permissionId  String
  isAllowed     Boolean  @default(true)
  conditions    Json?    // Additional conditions
  storeId       String?  // Store-specific permission
  expiresAt     DateTime? // Temporary permission
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  grantedBy     String?

  // Relations
  user          User        @relation(fields: [userId], references: [id])
  permission    Permission  @relation(fields: [permissionId], references: [id])
  store         Store?      @relation(fields: [storeId], references: [id])
  grantedByUser User?       @relation("UserPermissionGrantedBy", fields: [grantedBy], references: [id])

  @@unique([userId, permissionId, storeId])
  @@map("user_permissions")
  @@index([userId])
  @@index([permissionId])
  @@index([storeId])
  @@index([expiresAt])
}

// User-Group mapping
model UserGroup {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  storeId   String?  // Store-specific group assignment
  isPrimary Boolean  @default(false) // Primary group for the user
  assignedAt DateTime @default(now())
  assignedBy String?

  // Relations
  user        User    @relation(fields: [userId], references: [id])
  group       Group   @relation(fields: [groupId], references: [id])
  store       Store?  @relation(fields: [storeId], references: [id])
  assignedByUser User? @relation("UserGroupAssignedBy", fields: [assignedBy], references: [id])

  @@unique([userId, groupId, storeId])
  @@map("user_groups")
  @@index([userId])
  @@index([groupId])
  @@index([storeId])
}

// Role-Permission mapping (Direct role-based permissions)
model RolePermission {
  id            String   @id @default(cuid())
  role          UserRole
  permissionId  String
  isAllowed     Boolean  @default(true)
  conditions    Json?    // Additional conditions (e.g., store-specific, time-based)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  grantedBy     String?

  // Relations
  permission    Permission @relation(fields: [permissionId], references: [id])
  grantedByUser User?      @relation("RolePermissionGrantedBy", fields: [grantedBy], references: [id])

  @@unique([role, permissionId])
  @@map("role_permissions")
  @@index([role])
  @@index([permissionId])
  @@index([isAllowed])
}

// --- product.model.prisma ---
// ============================================
// Product & Menu Models
// ============================================

// Product Category
model Category {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  parentId    String?  // For category hierarchy
  image       String?
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@map("categories")
  @@index([parentId])
  @@index([code])
}

// Product (Menu Item)
model Product {
  id              String   @id @default(cuid())
  code            String   @unique // SKU/Product code
  name            String
  description     String?
  categoryId      String
  image           String?
  status          ProductStatus @default(ACTIVE)
  isAvailable     Boolean  @default(true)
  
  // Pricing (base price, can be overridden per store)
  basePrice       Decimal  @db.Decimal(10, 2)
  costPrice       Decimal? @db.Decimal(10, 2)
  
  // Attributes
  attributes      Json?    // e.g., size, flavor, etc.
  tags            String[] // For search/filtering
  
  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  // Relations
  category        Category @relation(fields: [categoryId], references: [id])
  productStores   ProductStore[]
  orderItems      OrderItem[]
  inventory       Inventory[]
  inventoryAdjustmentLines InventoryAdjustmentLine[]
  purchaseOrderItems PurchaseOrderItem[]
  tastings        Tasting[]
  createdByUser   User?    @relation("ProductCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User?    @relation("ProductUpdatedBy", fields: [updatedBy], references: [id])

  @@map("products")
  @@index([code])
  @@index([categoryId])
  @@index([status])
  @@index([isAvailable])
}

// Product-Store mapping with store-specific pricing
model ProductStore {
  id          String   @id @default(cuid())
  productId   String
  storeId     String
  price       Decimal  @db.Decimal(10, 2) // Store-specific price
  isAvailable Boolean  @default(true)
  stockLevel  Int?     // Current stock at store
  reorderLevel Int?    // Reorder threshold
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  product     Product  @relation(fields: [productId], references: [id])
  store       Store    @relation(fields: [storeId], references: [id])

  @@unique([productId, storeId])
  @@map("product_stores")
  @@index([productId])
  @@index([storeId])
  @@index([isAvailable])
}

// Tax Configuration
model Tax {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        TaxType
  rate        Decimal  @db.Decimal(5, 2) // Percentage (e.g., 18.00 for 18%)
  countryId   String?  // Country-specific tax
  regionId    String?  // Region-specific tax
  storeId     String?  // Store-specific tax
  isActive    Boolean  @default(true)
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  country     Country? @relation(fields: [countryId], references: [id])
  region      Region?  @relation(fields: [regionId], references: [id])
  store       Store?   @relation(fields: [storeId], references: [id])
  orderItems  OrderItem[]

  @@map("taxes")
  @@index([code])
  @@index([type])
  @@index([countryId])
  @@index([regionId])
  @@index([storeId])
  @@index([isActive])
}

// --- promotion.model.prisma ---
// ============================================
// Promotions Configuration Models
// ============================================

enum PromotionType {
  BASIC
  ADVANCED
}

enum PromotionStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

model Promotion {
  id               String           @id @default(cuid())
  tenantId         String?

  name             String
  description      String?

  type             PromotionType
  status           PromotionStatus  @default(ACTIVE)

  // Schedule and timing
  schedule         Json
  startDate        DateTime?
  endDate          DateTime?
  scheduleType     String?          // "one-time" | "recurring"
  noEndDate        Boolean          @default(false)

  // Scope & targeting
  outletIds        String[]         // References Store.id
  orderChannels    OrderChannel[]   // Reuse existing BOGO OrderChannel enum
  applicationMethod String          @default("auto")      // "auto" | "manual"
  targetAudience   String           @default("everyone")  // "everyone" | "exclusive"
  customerGroups   String[]         // E.g. ["vip", "new_customers"]
  promoCode        String?

  // Behaviour flags
  showPromptOnSell Boolean          @default(true)
  offerLoyalty     Boolean          @default(false)

  // Detailed configuration blobs (mirror UI payload structure)
  discount         Json?
  triggerCondition Json?
  rewardAction     Json?

  // Audit
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  tenant           Tenant?          @relation(fields: [tenantId], references: [id])

  @@map("promotions")
  @@index([tenantId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([promoCode])
}

// --- purchase.model.prisma ---
// ============================================
// Purchase Management Models
// ============================================
// Note: PurchaseOrderStatus, GRNStatus, and DeliveryStatus enums are defined in enums.prisma

// Supplier/Vendor Model
model Supplier {
  id                String   @id @default(cuid())
  code              String   @unique // Supplier code (e.g., "SUP001")
  name              String
  contactPerson     String?
  email             String?
  phone             String?
  mobile            String?
  
  // Address
  address           String?
  city              String?
  state             String?
  postalCode        String?
  country           String?
  
  // Tax Information
  taxId             String?  // Tax ID/GST Number
  taxType           String?  // GST, VAT, etc.
  
  // Payment Terms
  paymentTerms      String?  // e.g., "Net 30", "COD"
  creditLimit       Decimal?  @db.Decimal(10, 2)
  
  // Status
  isActive          Boolean  @default(true)
  rating            Int?     // Supplier rating (1-5)
  notes             String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?
  updatedBy         String?

  // Relations
  purchaseOrders    PurchaseOrder[]
  createdByUser     User?    @relation("SupplierCreatedBy", fields: [createdBy], references: [id])
  updatedByUser     User?    @relation("SupplierUpdatedBy", fields: [updatedBy], references: [id])

  @@map("suppliers")
  @@index([code])
  @@index([name])
  @@index([isActive])
}

// Purchase Order Model
model PurchaseOrder {
  id                    String              @id @default(cuid())
  orderNumber            String              @unique // e.g., "PO-2025-001234"
  supplierId             String
  storeId                String
  
  // Order Details
  status                 PurchaseOrderStatus @default(DRAFT)
  orderDate              DateTime            @default(now())
  expectedDeliveryDate   DateTime?
  actualDeliveryDate     DateTime?
  
  // Pricing
  subtotal               Decimal             @db.Decimal(10, 2)
  taxAmount              Decimal             @default(0) @db.Decimal(10, 2)
  discountAmount         Decimal             @default(0) @db.Decimal(10, 2)
  totalAmount            Decimal             @db.Decimal(10, 2)
  
  // Delivery
  deliveryStatus         DeliveryStatus      @default(PENDING)
  deliveryAddress        String?
  trackingNumber         String?
  
  // Approval
  requiresApproval       Boolean             @default(false)
  approvedBy             String?
  approvedAt             DateTime?
  rejectedBy             String?
  rejectedAt             DateTime?
  rejectionReason        String?
  
  // Metadata
  notes                  String?
  reference              String?            // External reference
  currency               String              @default("USD")
  
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  createdBy              String?
  updatedBy              String?

  // Relations
  supplier               Supplier            @relation(fields: [supplierId], references: [id])
  store                  Store               @relation(fields: [storeId], references: [id])
  items                  PurchaseOrderItem[]
  grns                   GRN[]
  createdByUser          User?               @relation("PurchaseOrderCreatedBy", fields: [createdBy], references: [id])
  updatedByUser          User?               @relation("PurchaseOrderUpdatedBy", fields: [updatedBy], references: [id])
  approvedByUser          User?               @relation("PurchaseOrderApprovedBy", fields: [approvedBy], references: [id])
  rejectedByUser         User?               @relation("PurchaseOrderRejectedBy", fields: [rejectedBy], references: [id])

  @@map("purchase_orders")
  @@index([orderNumber])
  @@index([supplierId])
  @@index([storeId])
  @@index([status])
  @@index([orderDate])
  @@index([deliveryStatus])
  @@index([requiresApproval])
}

// Purchase Order Item
model PurchaseOrderItem {
  id                String   @id @default(cuid())
  purchaseOrderId  String
  productId         String
  
  // Item Details
  quantity          Int
  unitPrice         Decimal  @db.Decimal(10, 2)
  taxRate           Decimal? @db.Decimal(5, 2)
  taxAmount         Decimal  @default(0) @db.Decimal(10, 2)
  discount          Decimal  @default(0) @db.Decimal(10, 2)
  totalPrice        Decimal  @db.Decimal(10, 2)
  
  // Received Quantities
  quantityReceived  Int      @default(0)
  quantityPending   Int      // quantity - quantityReceived
  
  // Notes
  notes             String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product           Product       @relation(fields: [productId], references: [id])
  grnItems          GRNItem[]

  @@map("purchase_order_items")
  @@index([purchaseOrderId])
  @@index([productId])
}

// GRN (Goods Receipt Note)
model GRN {
  id                String      @id @default(cuid())
  grnNumber         String      @unique // e.g., "GRN-2025-001234"
  purchaseOrderId   String
  storeId           String
  
  // Status
  status            GRNStatus   @default(PENDING)
  receivedDate      DateTime    @default(now())
  receivedBy        String?
  
  // Quality Check
  qualityChecked    Boolean     @default(false)
  qualityCheckedBy  String?
  qualityCheckedAt  DateTime?
  qualityNotes      String?
  
  // Metadata
  notes             String?
  invoiceNumber    String?
  invoiceDate      DateTime?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  createdBy         String?

  // Relations
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  store             Store         @relation(fields: [storeId], references: [id])
  items             GRNItem[]
  createdByUser     User?         @relation("GRNCreatedBy", fields: [createdBy], references: [id])
  receivedByUser    User?         @relation("GRNReceivedBy", fields: [receivedBy], references: [id])
  qualityCheckedByUser User?      @relation("GRNQualityCheckedBy", fields: [qualityCheckedBy], references: [id])

  @@map("grns")
  @@index([grnNumber])
  @@index([purchaseOrderId])
  @@index([storeId])
  @@index([status])
  @@index([receivedDate])
}

// GRN Item
model GRNItem {
  id                String   @id @default(cuid())
  grnId             String
  purchaseOrderItemId String
  
  // Received Details
  quantityReceived  Int
  quantityAccepted  Int      // After quality check
  quantityRejected  Int      @default(0) // Rejected quantity
  rejectionReason   String?
  
  // Cost
  unitCost          Decimal? @db.Decimal(10, 2)
  totalCost         Decimal? @db.Decimal(10, 2)
  
  // Notes
  notes             String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  grn               GRN              @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  @@map("grn_items")
  @@index([grnId])
  @@index([purchaseOrderItemId])
}

// --- store.model.prisma ---
// ============================================
// Store & Organization Models
// ============================================

// Country model
model Country {
  id          String   @id @default(cuid())
  code        String   @unique // ISO country code (e.g., "US", "IN")
  name        String
  currency    String   // ISO currency code (e.g., "USD", "INR")
  timezone    String   // e.g., "America/New_York"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  regions     Region[]
  stores      Store[]
  taxes       Tax[]

  @@map("countries")
  @@index([code])
}

// Region model (for regional data centers)
model Region {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "US_EAST", "APAC_INDIA"
  name        String
  countryId   String
  description String?
  dataCenterUrl String? // Regional data center API URL
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  country     Country  @relation(fields: [countryId], references: [id])
  stores      Store[]
  syncLogs    SyncLog[]
  accessPermissions AccessPermission[]
  taxes       Tax[]

  @@map("regions")
  @@index([countryId])
  @@index([code])
}

// Store model
model Store {
  id              String      @id @default(cuid())
  code            String      @unique // Store code (e.g., "ST001", "NYC_001")
  name            String
  storeType       StoreType
  status          StoreStatus @default(ACTIVE)
  tenantId        String?     // Tenant/Brand the store belongs to
  countryId       String
  regionId        String
  parentStoreId   String?     // For multi-level store hierarchy
  
  // Address
  address         String
  city            String
  state           String?
  postalCode      String?
  latitude        Float?
  longitude       Float?
  
  // Contact
  phone           String?
  email           String?
  
  // Configuration
  timezone        String
  currency        String
  taxConfig       Json?       // Tax configuration per region
  paymentConfig   Json?       // Payment methods enabled
  
  // Store Server Info
  localServerUrl  String?     // Local store server URL
  lastSyncAt      DateTime?
  syncStatus      SyncStatus  @default(PENDING)
  
  // Ownership
  ownershipType   StoreType
  licenseNumber   String?     // For licensed stores
  licenseExpiry   DateTime?
  
  // Metadata
  isActive        Boolean     @default(true)
  openedAt        DateTime?
  closedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdBy       String?
  updatedBy       String?

  // Relations
  tenant          Tenant?     @relation("StoreTenant", fields: [tenantId], references: [id])
  country         Country     @relation(fields: [countryId], references: [id])
  region          Region      @relation(fields: [regionId], references: [id])
  parentStore     Store?      @relation("StoreHierarchy", fields: [parentStoreId], references: [id])
  childStores     Store[]     @relation("StoreHierarchy")
  
  storeOwnerships StoreOwnership[]
  userStores      UserStore[]
  products        ProductStore[]
  orders          Order[]
  inventory       Inventory[]
  syncLogs        SyncLog[]
  accessPermissions AccessPermission[]
  userPermissions UserPermission[]
  userGroups      UserGroup[]
  auditLogs       AuditLog[]
  taxes           Tax[]
  defaultUsers    User[]      @relation("UserDefaultStore")
  purchaseOrders PurchaseOrder[]
  grns           GRN[]
  inventoryAdjustments InventoryAdjustment[]
  kots           KOT[]

  createdByUser   User?       @relation("StoreCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User?       @relation("StoreUpdatedBy", fields: [updatedBy], references: [id])

  @@map("stores")
  @@index([code])
  @@index([storeType])
  @@index([status])
  @@index([tenantId])
  @@index([countryId])
  @@index([regionId])
  @@index([parentStoreId])
  @@index([isActive])
}

// Store Ownership Model (for Licensed Stores & Joint Ventures)
model StoreOwnership {
  id              String   @id @default(cuid())
  storeId         String
  ownershipType   StoreType
  ownerName       String   // e.g., "Tata Consumer Products Limited"
  licenseNumber   String?  // License/franchise number
  licenseStartDate DateTime?
  licenseEndDate   DateTime?
  contractDetails Json?    // Contract details, terms, etc.
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  // Relations
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdByUser   User?    @relation("StoreOwnershipCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User?    @relation("StoreOwnershipUpdatedBy", fields: [updatedBy], references: [id])

  @@map("store_ownerships")
  @@index([storeId])
  @@index([ownershipType])
  @@index([isActive])
}

// User-Store Assignment (many-to-many)
model UserStore {
  id          String   @id @default(cuid())
  userId      String
  storeId     String
  isPrimary   Boolean  @default(false) // Primary store for the user
  assignedAt  DateTime @default(now())
  assignedBy  String?
  expiresAt   DateTime? // For temporary assignments

  // Relations
  user        User     @relation(fields: [userId], references: [id])
  store       Store    @relation(fields: [storeId], references: [id])
  assignedByUser User? @relation("UserStoreAssignedBy", fields: [assignedBy], references: [id])

  @@unique([userId, storeId])
  @@map("user_stores")
  @@index([userId])
  @@index([storeId])
  @@index([isPrimary])
}

// --- sync.model.prisma ---
// ============================================
// Sync & Audit Models
// ============================================

// Sync Log (for store-regional-global sync)
model SyncLog {
  id          String   @id @default(cuid())
  storeId     String?
  regionId    String?
  
  // Sync Details
  syncType    String   // e.g., "FULL", "INCREMENTAL", "PRODUCTS", "ORDERS"
  direction   SyncDirection
  status      SyncStatus @default(PENDING)
  
  // Data
  recordsCount Int?
  recordsSynced Int    @default(0)
  recordsFailed Int   @default(0)
  
  // Timing
  startedAt   DateTime @default(now())
  completedAt DateTime?
  duration    Int?     // Duration in milliseconds
  
  // Error Handling
  errorMessage String?
  errorDetails Json?
  
  // Metadata
  metadata    Json?    // Additional sync metadata
  createdAt   DateTime @default(now())

  // Relations
  store       Store?   @relation(fields: [storeId], references: [id])
  region      Region?  @relation(fields: [regionId], references: [id])

  @@map("sync_logs")
  @@index([storeId])
  @@index([regionId])
  @@index([syncType])
  @@index([status])
  @@index([startedAt])
}

// Audit Log (for tracking all system changes)
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  storeId     String?
  
  // Action Details
  action      AuditAction
  resource    String   // e.g., "User", "Order", "Product"
  resourceId  String?  // ID of the affected resource
  
  // Changes
  oldValues   Json?    // Previous values
  newValues   Json?    // New values
  changes     Json?    // Diff of changes
  
  // Request Info
  ipAddress   String?
  userAgent   String?
  requestId   String?
  
  // Metadata
  metadata    Json?    // Additional audit metadata
  createdAt   DateTime @default(now())

  // Relations
  user        User?    @relation(fields: [userId], references: [id])
  store       Store?   @relation(fields: [storeId], references: [id])

  @@map("audit_logs")
  @@index([userId])
  @@index([storeId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
}

// --- tenant.model.prisma ---
// ============================================
// Tenant (Brand) Management Models
// ============================================

// Tenant Model (Brand/Customer)
model Tenant {
  id                String            @id @default(cuid())
  code              String            @unique // Tenant code (e.g., "TENANT001", "BRAND001")
  name              String            // Brand/Tenant name
  domain            String?           @unique // Domain/subdomain (e.g., "brand1.pos.com")
  
  // Status
  status            TenantStatus      @default(ACTIVE)
  
  // Subscription
  subscriptionPlan  SubscriptionPlan  @default(BASIC)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  maxUsers          Int               @default(10)
  maxStores         Int               @default(5)
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  
  // Address
  address           String?
  city              String?
  state             String?
  zipCode           String?
  country           String?
  
  // Contact
  primaryContact    String?
  email             String?           @unique
  phone             String?
  mobile            String?
  
  // Settings
  currency          String            @default("USD")
  timezone          String            @default("UTC")
  language          String            @default("en")
  dateFormat        String            @default("YYYY-MM-DD")
  
  // Features
  features          Json?             // Feature flags (inventory, sales, purchases, reports, multiStore, apiAccess)
  
  // Metadata
  notes             String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String?
  updatedBy         String?

  // Relations
  stores            Store[]           @relation("StoreTenant")
  users             User[]            @relation("UserTenant")
  subscriptions     Subscription[]
  bogoOffers        BOGOOffer[]
  promotions        Promotion[]
  createdByUser     User?             @relation("TenantCreatedBy", fields: [createdBy], references: [id])
  updatedByUser     User?             @relation("TenantUpdatedBy", fields: [updatedBy], references: [id])

  @@map("tenants")
  @@index([code])
  @@index([domain])
  @@index([status])
  @@index([subscriptionStatus])
  @@index([isActive])
}

// Subscription History
model Subscription {
  id                String            @id @default(cuid())
  tenantId          String
  plan              SubscriptionPlan
  status            SubscriptionStatus
  startDate         DateTime
  endDate           DateTime?
  amount            Decimal?           @db.Decimal(10, 2)
  billingCycle      String?           // MONTHLY, YEARLY, etc.
  autoRenew         Boolean           @default(false)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String?

  // Relations
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser     User?             @relation("SubscriptionCreatedBy", fields: [createdBy], references: [id])

  @@map("subscriptions")
  @@index([tenantId])
  @@index([status])
  @@index([startDate])
}

// --- user.model.prisma ---
// ============================================
// User Management Models
// ============================================

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  username          String?     @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  role              UserRole    @default(USER)
  status            UserStatus  @default(PENDING_VERIFICATION)
  emailVerified     Boolean     @default(false)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  passwordResetToken String?
  passwordResetAt   DateTime?
  profileImage      String?
  
  // Multi-tenant support
  tenantId          String?     // Tenant/Brand the user belongs to
  
  // Multi-store support
  defaultStoreId    String?     // Default store for the user
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  createdBy         String?
  updatedBy         String?

  // Relations - User Hierarchy
  createdUsers      User[]      @relation("UserCreatedBy")
  updatedUsers      User[]      @relation("UserUpdatedBy")
  createdByUser     User?       @relation("UserCreatedBy", fields: [createdBy], references: [id])
  updatedByUser     User?       @relation("UserUpdatedBy", fields: [updatedBy], references: [id])
  
  // Relations - Multi-tenant
  tenant            Tenant?     @relation("UserTenant", fields: [tenantId], references: [id])
  
  // Relations - Multi-store
  defaultStore      Store?      @relation("UserDefaultStore", fields: [defaultStoreId], references: [id])
  userStores        UserStore[]
  
  // Relations - Permissions
  userGroups        UserGroup[]
  userPermissions   UserPermission[]
  
  // Relations - Group Management
  groupsCreated     Group[]      @relation("GroupCreatedBy")
  groupsUpdated     Group[]      @relation("GroupUpdatedBy")
  
  // Relations - Permission Management
  groupPermissionsGranted GroupPermission[] @relation("GroupPermissionGrantedBy")
  userPermissionsGranted  UserPermission[]  @relation("UserPermissionGrantedBy")
  rolePermissionsGranted  RolePermission[]   @relation("RolePermissionGrantedBy")
  userGroupsAssigned      UserGroup[]       @relation("UserGroupAssignedBy")
  userStoresAssigned      UserStore[]       @relation("UserStoreAssignedBy")
  
  // Relations - Access Permissions
  accessPermissionsCreated AccessPermission[] @relation("AccessPermissionCreatedBy")
  accessPermissionsUpdated AccessPermission[] @relation("AccessPermissionUpdatedBy")
  
  // Relations - Store Management
  storesCreated     Store[]      @relation("StoreCreatedBy")
  storesUpdated     Store[]      @relation("StoreUpdatedBy")
  
  // Relations - Store Ownership
  storeOwnershipsCreated StoreOwnership[] @relation("StoreOwnershipCreatedBy")
  storeOwnershipsUpdated StoreOwnership[] @relation("StoreOwnershipUpdatedBy")
  
  // Relations - Orders
  ordersCreated     Order[]      @relation("OrderCreatedBy")
  ordersUpdated     Order[]      @relation("OrderUpdatedBy")
  ordersCancelled   Order[]      @relation("OrderCancelledBy")
  
  // Relations - Products
  productsCreated   Product[]    @relation("ProductCreatedBy")
  productsUpdated   Product[]    @relation("ProductUpdatedBy")
  
  // Relations - Inventory
  inventoryUpdated  Inventory[]  @relation("InventoryUpdatedBy")
  inventoryMovements InventoryMovement[] @relation("InventoryMovementCreatedBy")
  inventoryAdjustmentsCreated InventoryAdjustment[] @relation("InventoryAdjustmentCreatedBy")
  
  // Relations - Loyalty
  loyaltyTransactionsCreated LoyaltyTransaction[] @relation("LoyaltyTransactionCreatedBy")
  
  // Relations - Audit
  auditLogs         AuditLog[]
  
  // Relations - Tenant Management
  tenantsCreated    Tenant[]    @relation("TenantCreatedBy")
  tenantsUpdated    Tenant[]    @relation("TenantUpdatedBy")
  subscriptionsCreated Subscription[] @relation("SubscriptionCreatedBy")
  
  // Relations - Purchase Management
  suppliersCreated  Supplier[]  @relation("SupplierCreatedBy")
  suppliersUpdated  Supplier[]  @relation("SupplierUpdatedBy")
  purchaseOrdersCreated PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  purchaseOrdersUpdated PurchaseOrder[] @relation("PurchaseOrderUpdatedBy")
  purchaseOrdersApproved PurchaseOrder[] @relation("PurchaseOrderApprovedBy")
  purchaseOrdersRejected PurchaseOrder[] @relation("PurchaseOrderRejectedBy")
  grnsCreated       GRN[]       @relation("GRNCreatedBy")
  grnsReceived      GRN[]       @relation("GRNReceivedBy")
  grnsQualityChecked GRN[]      @relation("GRNQualityCheckedBy")
  
  // Relations - Sales Management
  ordersHeld        Order[]      @relation("OrderHeldBy")
  ordersResumed    Order[]      @relation("OrderResumedBy")
  kotsCreated       KOT[]       @relation("KOTCreatedBy")
  tastingsCreated   Tasting[]   @relation("TastingCreatedBy")
  bogoOffersCreated BOGOOffer[] @relation("BOGOCreatedBy")
  bogoOffersUpdated BOGOOffer[] @relation("BOGOUpdatedBy")
  bogoApplications  BOGOApplication[] @relation("BOGOAppliedBy")
  vouchersRedeemed  BOGOVoucher[] @relation("VoucherRedeemedBy")

  @@map("users")
  @@index([email])
  @@index([username])
  @@index([role])
  @@index([status])
  @@index([tenantId])
  @@index([defaultStoreId])
}

