// ============================================
// Order & Sales Models
// ============================================

// Order
model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique // e.g., "ORD-2025-001234"
  storeId         String
  customerId      String?     // For registered customers
  customerName    String?     // For guest orders
  customerPhone   String?
  customerEmail   String?
  
  // Order Details
  status          OrderStatus @default(PENDING)
  orderType       String?     // e.g., "DINE_IN", "TAKEAWAY", "DELIVERY"
  
  // Pricing
  subtotal        Decimal     @db.Decimal(10, 2)
  taxAmount       Decimal     @db.Decimal(10, 2)
  discountAmount  Decimal    @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal     @db.Decimal(10, 2)
  loyaltyPointsUsed Int?      @default(0)
  loyaltyPointsEarned Int?    @default(0)
  
  // Payment
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod?
  
  // Order Hold/Resume
  isHeld          Boolean     @default(false)
  heldAt          DateTime?
  heldBy          String?
  heldReason      String?
  resumedAt       DateTime?
  resumedBy       String?
  
  // Metadata
  notes           String?
  orderDate       DateTime    @default(now())
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelledBy    String?
  cancelledReason String?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdBy       String?
  updatedBy       String?

  // Relations
  store           Store       @relation(fields: [storeId], references: [id])
  customer        Customer?   @relation(fields: [customerId], references: [id])
  orderItems      OrderItem[]
  payments        Payment[]
  loyaltyTransactions LoyaltyTransaction[]
  createdByUser   User?       @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User?       @relation("OrderUpdatedBy", fields: [updatedBy], references: [id])
  cancelledByUser User?      @relation("OrderCancelledBy", fields: [cancelledBy], references: [id])
  heldByUser      User?       @relation("OrderHeldBy", fields: [heldBy], references: [id])
  resumedByUser   User?       @relation("OrderResumedBy", fields: [resumedBy], references: [id])
  kots            KOT[]
  tastings        Tasting[]
  bogoApplications BOGOApplication[]
  vouchersGenerated BOGOVoucher[] @relation("VoucherGeneratedFrom")
  vouchersRedeemed BOGOVoucher[] @relation("VoucherRedeemedIn")

  @@map("orders")
  @@index([orderNumber])
  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@index([paymentStatus])
  @@index([isHeld])
}

// KOT (Kitchen Order Ticket)
model KOT {
  id                String   @id @default(cuid())
  kotNumber         String   @unique // e.g., "KOT-2025-001234"
  orderId           String
  storeId           String
  
  // KOT Details
  status            String   @default("PENDING") // PENDING, SENT, PREPARING, READY, COMPLETED
  items             Json     // Array of order items for kitchen
  tableNumber       String?
  notes             String?
  
  // Timing
  sentAt            DateTime @default(now())
  completedAt       DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?

  // Relations
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store             Store    @relation(fields: [storeId], references: [id])
  createdByUser     User?    @relation("KOTCreatedBy", fields: [createdBy], references: [id])

  @@map("kots")
  @@index([kotNumber])
  @@index([orderId])
  @@index([storeId])
  @@index([status])
  @@index([sentAt])
}

// Tasting Tracking
model Tasting {
  id                String   @id @default(cuid())
  orderId           String
  productId         String
  
  // Tasting Details
  quantity          Int      @default(1)
  tastingType       String   @default("SAMPLE") // SAMPLE, COMPLIMENTARY, PROMOTIONAL
  customerFeedback  String?  // Customer feedback on tasting
  notes             String?
  
  createdAt         DateTime @default(now())
  createdBy         String?

  // Relations
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id])
  createdByUser     User?    @relation("TastingCreatedBy", fields: [createdBy], references: [id])

  @@map("tastings")
  @@index([orderId])
  @@index([productId])
  @@index([createdAt])
}

// Order Item
model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  taxId       String?
  
  // Item Details
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  taxRate     Decimal? @db.Decimal(5, 2)
  taxAmount   Decimal  @default(0) @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  
  // Customizations
  notes       String?
  attributes  Json?    // e.g., size, add-ons, etc.
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  tax         Tax?     @relation(fields: [taxId], references: [id])

  @@map("order_items")
  @@index([orderId])
  @@index([productId])
}

// Payment
model Payment {
  id              String         @id @default(cuid())
  orderId         String
  paymentMethod   PaymentMethod
  amount          Decimal        @db.Decimal(10, 2)
  status          PaymentStatus  @default(PENDING)
  
  // Transaction Details
  transactionId   String?        @unique // External transaction ID
  referenceNumber String?        // Payment reference
  receiptUrl      String?        // Receipt/image URL
  
  // Metadata
  processedAt      DateTime?
  refundedAt      DateTime?
  refundAmount    Decimal?       @db.Decimal(10, 2)
  refundReason    String?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
  @@index([orderId])
  @@index([transactionId])
  @@index([status])
  @@index([paymentMethod])
}

