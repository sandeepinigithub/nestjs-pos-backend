// ============================================
// User Management Models
// ============================================

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  username          String?     @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  role              UserRole    @default(USER)
  status            UserStatus  @default(PENDING_VERIFICATION)
  emailVerified     Boolean     @default(false)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  passwordResetToken String?
  passwordResetAt   DateTime?
  profileImage      String?
  
  // Multi-tenant support
  tenantId          String?     // Tenant/Brand the user belongs to
  
  // Multi-store support
  defaultStoreId    String?     // Default store for the user
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  createdBy         String?
  updatedBy         String?

  // Relations - User Hierarchy
  createdUsers      User[]      @relation("UserCreatedBy")
  updatedUsers      User[]      @relation("UserUpdatedBy")
  createdByUser     User?       @relation("UserCreatedBy", fields: [createdBy], references: [id])
  updatedByUser     User?       @relation("UserUpdatedBy", fields: [updatedBy], references: [id])
  
  // Relations - Multi-tenant
  tenant            Tenant?     @relation("UserTenant", fields: [tenantId], references: [id])
  
  // Relations - Multi-store
  defaultStore      Store?      @relation("UserDefaultStore", fields: [defaultStoreId], references: [id])
  userStores        UserStore[]
  
  // Relations - Permissions
  userGroups        UserGroup[]
  userPermissions   UserPermission[]
  
  // Relations - Group Management
  groupsCreated     Group[]      @relation("GroupCreatedBy")
  groupsUpdated     Group[]      @relation("GroupUpdatedBy")
  
  // Relations - Permission Management
  groupPermissionsGranted GroupPermission[] @relation("GroupPermissionGrantedBy")
  userPermissionsGranted  UserPermission[]  @relation("UserPermissionGrantedBy")
  rolePermissionsGranted  RolePermission[]   @relation("RolePermissionGrantedBy")
  userGroupsAssigned      UserGroup[]       @relation("UserGroupAssignedBy")
  userStoresAssigned      UserStore[]       @relation("UserStoreAssignedBy")
  
  // Relations - Access Permissions
  accessPermissionsCreated AccessPermission[] @relation("AccessPermissionCreatedBy")
  accessPermissionsUpdated AccessPermission[] @relation("AccessPermissionUpdatedBy")
  
  // Relations - Store Management
  storesCreated     Store[]      @relation("StoreCreatedBy")
  storesUpdated     Store[]      @relation("StoreUpdatedBy")
  
  // Relations - Store Ownership
  storeOwnershipsCreated StoreOwnership[] @relation("StoreOwnershipCreatedBy")
  storeOwnershipsUpdated StoreOwnership[] @relation("StoreOwnershipUpdatedBy")
  
  // Relations - Orders
  ordersCreated     Order[]      @relation("OrderCreatedBy")
  ordersUpdated     Order[]      @relation("OrderUpdatedBy")
  ordersCancelled   Order[]      @relation("OrderCancelledBy")
  
  // Relations - Products
  productsCreated   Product[]    @relation("ProductCreatedBy")
  productsUpdated   Product[]    @relation("ProductUpdatedBy")
  
  // Relations - Inventory
  inventoryUpdated  Inventory[]  @relation("InventoryUpdatedBy")
  inventoryMovements InventoryMovement[] @relation("InventoryMovementCreatedBy")
  inventoryAdjustmentsCreated InventoryAdjustment[] @relation("InventoryAdjustmentCreatedBy")
  
  // Relations - Loyalty
  loyaltyTransactionsCreated LoyaltyTransaction[] @relation("LoyaltyTransactionCreatedBy")
  
  // Relations - Audit
  auditLogs         AuditLog[]
  
  // Relations - Tenant Management
  tenantsCreated    Tenant[]    @relation("TenantCreatedBy")
  tenantsUpdated    Tenant[]    @relation("TenantUpdatedBy")
  subscriptionsCreated Subscription[] @relation("SubscriptionCreatedBy")
  
  // Relations - Purchase Management
  suppliersCreated  Supplier[]  @relation("SupplierCreatedBy")
  suppliersUpdated  Supplier[]  @relation("SupplierUpdatedBy")
  purchaseOrdersCreated PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  purchaseOrdersUpdated PurchaseOrder[] @relation("PurchaseOrderUpdatedBy")
  purchaseOrdersApproved PurchaseOrder[] @relation("PurchaseOrderApprovedBy")
  purchaseOrdersRejected PurchaseOrder[] @relation("PurchaseOrderRejectedBy")
  grnsCreated       GRN[]       @relation("GRNCreatedBy")
  grnsReceived      GRN[]       @relation("GRNReceivedBy")
  grnsQualityChecked GRN[]      @relation("GRNQualityCheckedBy")
  
  // Relations - Sales Management
  ordersHeld        Order[]      @relation("OrderHeldBy")
  ordersResumed    Order[]      @relation("OrderResumedBy")
  kotsCreated       KOT[]       @relation("KOTCreatedBy")
  tastingsCreated   Tasting[]   @relation("TastingCreatedBy")
  bogoOffersCreated BOGOOffer[] @relation("BOGOCreatedBy")
  bogoOffersUpdated BOGOOffer[] @relation("BOGOUpdatedBy")
  bogoApplications  BOGOApplication[] @relation("BOGOAppliedBy")
  vouchersRedeemed  BOGOVoucher[] @relation("VoucherRedeemedBy")

  @@map("users")
  @@index([email])
  @@index([username])
  @@index([role])
  @@index([status])
  @@index([tenantId])
  @@index([defaultStoreId])
}

