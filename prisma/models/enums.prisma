enum UserRole {
  // Platform Level
  SUPER_ADMIN          // Platform Admin - manages all tenants
  TENANT_ADMIN         // Tenant Admin (Brand) - manages tenant stores and users
  STORE_ADMIN          // Store Admin (CompanyOwned or FranchiseOwned)
  STORE_MANAGER        // Store Manager - manages store operations
  CASHIER              // Cashier - handles POS sales and billing
  KITCHEN_STAFF        // Kitchen Staff (KDS) - manages kitchen orders
  INVENTORY_MANAGER    // Inventory Manager - manages inventory
  PURCHASE_MANAGER     // Purchase Manager - manages purchases
  ACCOUNTANT           // Accountant - financial view access
  SUPPORT_STAFF        // Support Staff - view access
  SYSTEM_AUDITOR       // System Auditor - compliance and logs access
  HR_MANAGER           // HR Manager - user management view
  USER                 // Generic user (legacy)
}

